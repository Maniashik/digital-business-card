generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Profile {
    id               Int    @id @default(autoincrement())
    name             String
    shortDescription String
    githubUrl   String?
    linkedInUrl String?
    skills      Skill[]
    experiences Experience[]
    projects    Project[]
}

model Skill {
    id   Int    @id @default(autoincrement())
    name String

    profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    profileId Int
}

model Experience {
    id           Int       @id @default(autoincrement())
    company      String
    position     String
    startDate    DateTime
    endDate      DateTime? // null по настоящее время
    achievements String[]

    profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    profileId Int
}

model Project {
    id   Int    @id @default(autoincrement())
    name String
    url  String

    profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    profileId Int
}
